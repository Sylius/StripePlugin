{
    "name": "flux-se/sylius-stripe-plugin",
    "description": "Sylius Stripe plugin using Payment Request",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin", "stripe", "payum", "gateway", "sca", "checkout", "session"],
    "license": "MIT",
    "authors": [
        {
            "name": "Francis HILAIRE",
            "email": "Prometee@users.noreply.github.com"
        }
    ],
    "require": {
        "stripe/stripe-php": "^20.0",
        "sylius/core-bundle": "^2.1.16 || ^2.2.9 || ^2.3",
        "sylius/telemetry": "^1.0"
    },
    "require-dev": {
        "behat/behat": "^3.22 || 4.0.0-alpha1",
        "behat/mink": "^1.13",
        "dbrekelmans/bdi": "^1.2",
        "doctrine/data-fixtures": "^1.8 || ^2.2",
        "doctrine/orm": "^3.3",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7.5 || 3.0.0-alpha1",
        "friends-of-behat/page-object-extension": "^0.4",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^1.7",
        "lchrusciel/api-test-case": "^6.0",
        "nyholm/psr7": "^1.8",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^12.5",
        "robertfausk/behat-panther-extension": "^2.0",
        "spaze/phpstan-stripe": "^3.3",
        "sylius-labs/coding-standard": "^4.1",
        "sylius-labs/suite-tags-extension": "^0.3",
        "sylius/sylius": "^2.2.9 || ^2.3",
        "sylius/test-application": "^2.2.0@alpha || ^2.3.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "theofidry/alice-data-fixtures": "^1.7"
    },
    "prefer-stable": true,
    "suggest": {
        "sylius/shop-bundle": "Use the Sylius default front shop",
        "sylius/admin-bundle": "Use the Sylius default admin",
        "sylius/api-bundle": "Use the Sylius default API"
    },
    "autoload": {
        "psr-4": {
            "FluxSE\\SyliusStripePlugin\\": "src/",
            "Tests\\FluxSE\\SyliusStripePlugin\\Behat\\": "tests/Behat"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\FluxSE\\SyliusStripePlugin\\": "tests/"
        }
    },
    "conflict": {
        "sylius/sylius": "<=2.0.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    }
}
