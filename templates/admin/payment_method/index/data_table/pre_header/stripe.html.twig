{% import '@SyliusAdmin/shared/helper/dropdown.html.twig' as dropdown %}

{% if not sylius_stripe_has_payment_method() %}
    <tr class="payment-method-list__item payment-method-list__item--suggested payment-method-list__item--stripe">
        <td colspan="2" class="text-center align-middle">
            <span class="badge bg-blue-lt">{{ 'flux_se_sylius_stripe_plugin.admin.payment_method.index.suggested.label'|trans }}</span>
        </td>

        <td colspan="1">
            <div class="payment-method-list__item-inner d-flex align-items-center gap-3">
                <div class="payment-method-list__logo d-flex align-items-center justify-content-center overflow-hidden p-2 flex-shrink-0">
                    <img src="{{ asset('build/admin/images/stripe-logo.svg', 'admin') }}" alt="Stripe">
                </div>

                <div class="payment-method-list__content d-flex flex-column gap-3">
                    <div class="payment-method-list__heading">
                        <h3 class="payment-method-list__name m-0 fw-semibold">Stripe</h3>
                        <p class="payment-method-list__description mt-1 mb-0">{{ 'flux_se_sylius_stripe_plugin.admin.payment_method.index.suggested.description'|trans }}</p>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        {% for method in ['visa', 'master_card', 'amex'] %}
                            <span class="payment-method-list__method d-inline-flex align-items-center justify-content-center">
                                <img src="{{ asset('build/admin/images/' ~ method ~ '.svg', 'admin') }}" alt="{{ method|replace({'_': ' '})|title }}">
                            </span>
                        {% endfor %}
                        <span class="payment-method-list__method payment-method-list__method--more d-inline-flex align-items-center justify-content-center px-1 fw-semibold">{{ 'sylius.ui.and_more'|trans }}</span>
                    </div>

                    <div class="payment-method-list__meta d-flex flex-wrap align-items-center gap-4 fw-medium">
                        <span class="d-inline-flex align-items-center gap-2">
                            {{ 'sylius.ui.code'|trans }}: <code class="payment-method-list__code px-2 py-1">stripe</code>
                        </span>
                        <span class="d-inline-flex align-items-center gap-2">
                            {{ 'sylius.ui.gateway'|trans }}: <span>Stripe</span>
                        </span>
                    </div>
                </div>
            </div>
        </td>

        <td colspan="4" class="payment-method-list__actions text-end">
            {{ dropdown.list(
                {
                    direction: 'down-end',
                    button: { text: 'flux_se_sylius_stripe_plugin.admin.payment_method.index.suggested.configure'|trans, icon: 'tabler:settings' }
                },
                [
                    {
                        title: 'flux_se_sylius_stripe_plugin.admin.payment_method.index.suggested.stripe_checkout',
                        url: path('sylius_admin_payment_method_create', { factory: 'stripe_checkout' }),
                    },
                    {
                        title: 'flux_se_sylius_stripe_plugin.admin.payment_method.index.suggested.stripe_web_element',
                        url: path('sylius_admin_payment_method_create', { factory: 'stripe_web_elements' }),
                    },
                ]
            ) }}
        </td>
    </tr>
{% endif %}
